# --- LLM (sem chave o A2 roda em modo extrativo: só texto aprovado das bases) ---
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b
LLM_TEMPERATURA=0.1
LLM_TIMEOUT_S=20

# --- Embeddings: sentence_transformers (padrão) | hashing (testes, sem download) ---
EMBEDDINGS_PROVEDOR=sentence_transformers
EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_DIM=384

# --- Índice: memoria (arquivo em indice_local/) | pgvector ---
RAG_STORE=memoria
# DATABASE_URL=postgresql+psycopg://svc_a2:senha@localhost:5432/sinergia
RAG_PASTA_BASES=bases_pdf

# --- Recuperação (rode `python -m agente_a2 calibrar` depois de trocar o modelo) ---
RAG_TOP_K=4
RAG_PESO_VETORIAL=0.6
# RAG_LIMIAR_COSSENO=0.45
RAG_LIMIAR_BM25=4.0
RAG_LIMIAR_PONTUACAO=0.40
# 1 = só responde com documento APROVADO (hoje as 4 bases estão PENDENTE)
RAG_EXIGIR_APROVACAO=0

# --- RAG completo ---
# 1 = o LLM reescreve a pergunta (com o histórico) e gera subconsultas para a busca múltipla.
#     Custa 1 chamada curta a mais por pergunta; use 0 se o limite do Groq apertar.
RAG_REESCRITA=1
# 1 = a resposta pode trazer uma "Dica:" de conhecimento geral, validada (sem números, leis, regras ou saúde clínica)
RAG_COMPLEMENTO=1

# --- Guardrails ---
A2_MAX_CHARS_PERGUNTA=1500
A2_MAX_CHARS_RESPOSTA=900
A2_CACHE_RESPOSTAS=1

# --- Registro de interações (melhoria contínua) ---
A2_REGISTRAR_INTERACOES=1
# SQLite local (padrão). Para Postgres: postgresql+psycopg://usuario:senha@localhost:5432/sinergia
# INTERACOES_DB_URL=sqlite:///dados/interacoes.db
# Troque em produção: é o segredo do pseudônimo do colaborador (HMAC)
A2_SAL_PSEUDONIMO=sinergia-dev
A2_RETENCAO_DIAS=180
